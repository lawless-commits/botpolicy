{
  "name": "botpolicy",
  "version": "0.0.0",
  "description": "Check what each AI crawler can actually reach on your site, and fail CI when that drifts from your written policy.",
  "license": "MIT",
  "author": "Josh Lawlor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lawless-commits/botpolicy.git"
  },
  "type": "module",
  "bin": {
    "botpolicy": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "action.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "pnpm build && pnpm pack"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
