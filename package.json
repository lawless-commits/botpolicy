{
  "name": "botpolicy",
  "version": "0.0.0",
  "description": "Check what each AI crawler can actually reach on your site, and fail CI when that drifts from your written policy.",
  "keywords": [
    "robots.txt",
    "ai-crawlers",
    "gptbot",
    "claudebot",
    "seo",
    "mcp",
    "mcp-server",
    "github-action",
    "policy",
    "cli"
  ],
  "license": "MIT",
  "author": "Josh Lawlor",
  "homepage": "https://github.com/lawless-commits/botpolicy#readme",
  "bugs": {
    "url": "https://github.com/lawless-commits/botpolicy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lawless-commits/botpolicy.git"
  },
  "mcpName": "io.github.lawless-commits/botpolicy",
  "type": "module",
  "bin": {
    "botpolicy": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/runner.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/scripts",
    "schema",
    "action.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "pnpm build && pnpm pack",
    "schema": "pnpm build && node dist/scripts/schema.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "parse5": "8.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
